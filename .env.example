# ──────────────────────────────────────────────────────────────
# Trackfluence — environment variables template
# Copy to .env and fill in all required values before running.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trackfluence?schema=public"

# ── API ───────────────────────────────────────────────────────
API_PORT=4000
# Required. Minimum 32 characters for production.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# ── Next.js ───────────────────────────────────────────────────
# Required. Public API base URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Production Docker ─────────────────────────────────────────
# Used by docker-compose.prod.yml
POSTGRES_PASSWORD=change-me-in-production

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Full Redis URL (used in production docker-compose)
REDIS_URL=redis://localhost:6379

# ── Email (Resend) ────────────────────────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Trackfluence <noreply@yourdomain.com>
APP_URL=http://localhost:3000

# ── Connectors — Shopify ──────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ── Sentry error monitoring ───────────────────────────────────
# Get your DSN from https://sentry.io → Project → Settings → Client Keys
# Leave empty to disable Sentry (safe for local dev)
SENTRY_DSN=
# Used by Next.js browser bundle (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=
# Required only for source map uploads in CI
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Stripe billing ────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# Public keys for Next.js (used in pricing page)
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_GROWTH=price_...

# ── PostHog Analytics ─────────────────────────────────────────
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Email (SMTP fallback) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=

# ── Connectors — Salesforce ───────────────────────────────────
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# ── Connectors — Meta CAPI ────────────────────────────────────
META_PIXEL_ID=
META_ACCESS_TOKEN=

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=development
